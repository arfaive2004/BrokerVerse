# Copy this file to .env and fill in real values -- it's loaded
# automatically on startup (via python-dotenv), no manual export needed.
# A real environment variable of the same name (e.g. one Vercel injects in
# production) always takes priority over whatever's in this file.

# Secret used to sign JWT auth tokens. Set this to a long random string in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Full Postgres connection string. Required for real deployments -- SQLite
# (used automatically when this is unset) is fine for local hacking, but
# is not durable on Vercel's serverless filesystem. Get a free instance from
# Neon (neon.tech), Supabase, or Vercel Postgres, then run `alembic upgrade
# head` once against it before starting the app for the first time.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of frontend URLs allowed to call this API from the
# browser (CORS). localhost:3000 is always allowed automatically for local
# dev, so you only need to list your deployed frontend's URL(s) here.
# Avoid "*" once real user data is involved.
CORS_ORIGINS=https://your-frontend.vercel.app

# Gemini API key used for AI-assisted document + selfie verification.
GEMINI_API_KEY=your-gemini-api-key
